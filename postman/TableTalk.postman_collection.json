{
  "info": {
    "_postman_id": "bc9e4f2b-83a8-4ed7-a311-f734b28a0405",
    "name": "TableTalk Restaurant Reviews API",
    "description": "Local API requests for customers, owners, and administrators. Log in to populate each token variable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "customerToken", "value": "" },
    { "key": "ownerToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "restaurantId", "value": "" },
    { "key": "reviewId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "url": "{{baseUrl}}/health" }
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register customer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"name\":\"New Customer\",\"email\":\"new.customer@example.com\",\"password\":\"Customer123!\"}" },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login customer",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 200) pm.collectionVariables.set('customerToken', pm.response.json().token);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\":\"customer@example.com\",\"password\":\"Customer123!\"}" },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Login owner",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 200) pm.collectionVariables.set('ownerToken', pm.response.json().token);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\":\"owner@example.com\",\"password\":\"Owner123!\"}" },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Login administrator",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 200) pm.collectionVariables.set('adminToken', pm.response.json().token);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\":\"admin@example.com\",\"password\":\"Admin123!\"}" },
            "url": "{{baseUrl}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "Restaurants",
      "item": [
        { "name": "Search restaurants", "request": { "method": "GET", "url": "{{baseUrl}}/restaurants?search=&location=&cuisine=" } },
        { "name": "Restaurant details", "request": { "method": "GET", "url": "{{baseUrl}}/restaurants/{{restaurantId}}" } },
        { "name": "Rating distribution", "request": { "method": "GET", "url": "{{baseUrl}}/restaurants/{{restaurantId}}/distribution" } },
        {
          "name": "Submit review",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"rating\":5,\"content\":\"Friendly service and a delicious meal.\"}" },
            "url": "{{baseUrl}}/reviews/restaurants/{{restaurantId}}/reviews"
          }
        }
      ]
    },
    {
      "name": "Customer review management",
      "item": [
        {
          "name": "Update review",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"rating\":4,\"content\":\"Updated: a lovely meal and attentive service.\"}" },
            "url": "{{baseUrl}}/reviews/{{reviewId}}"
          }
        },
        {
          "name": "Delete review",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": "{{baseUrl}}/reviews/{{reviewId}}"
          }
        }
      ]
    },
    {
      "name": "Restaurant owner",
      "item": [
        {
          "name": "View assigned restaurant and guests",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{ownerToken}}" }], "url": "{{baseUrl}}/owner/restaurant" }
        },
        {
          "name": "Update assigned restaurant",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{ownerToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"description\":\"A refreshed restaurant description.\"}" },
            "url": "{{baseUrl}}/owner/restaurant"
          }
        }
      ]
    },
    {
      "name": "Administrator",
      "item": [
        { "name": "Dashboard", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/admin/dashboard" } },
        { "name": "Search users", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/admin/users?search=" } },
        { "name": "Search restaurants", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/admin/restaurants?search=" } },
        { "name": "View reviews", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/admin/reviews" } }
      ]
    }
  ]
}
